# Copy to .env for local use. Never commit the real .env file.
# Anything starting with VITE_ is public in the browser bundle. Never put secrets there.
VITE_NEAR_NETWORK=testnet

# Server-side only (Vercel Environment Variables). NEVER prefix with VITE_.
# Used by web/api/analyze.js for the optional Gemini second opinion.
# If missing, the app falls back and works without AI.
GEMINI_API_KEY=
