# Copy this file to .env and fill it in. Never commit the real .env file.
#
# Anything starting with VITE_ is bundled into the public website, so it
# is visible to every visitor. NEVER put a private key, seed phrase or
# API secret in a VITE_ variable.
#
# The app does not read any variables yet. These are placeholders for later.
VITE_NEAR_NETWORK=testnet
